# Copy to .env for local Docker Compose use. Never commit .env.
# On Railway, set these as service variables in the dashboard instead of using this file.

# REQUIRED. Generate with: openssl rand -hex 32   (at least 32 characters; the prod profile refuses to start otherwise)
API_KEY=replace-with-a-long-random-value-of-at-least-32-characters

# Spring profile. "prod" enforces the API_KEY strength check. Use "default" only for throwaway local runs.
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL=INFO

# Host port mapped to the container's 8080
HOST_PORT=8080

# Limits (see document/CONFIGURATION.md)
MAX_UPLOAD_SIZE_MB=500
MAX_FILE_SIZE_MB=25
MAX_AUDIO_PARTS=200
MAX_AUDIO_DURATION_SECONDS=7200
MAX_CONCURRENT_JOBS=2
PROCESSING_TIMEOUT_SECONDS=900
OUTPUT_RETENTION_HOURS=24

# Optional: public base URL used when building download links, e.g. https://media.example.com
PUBLIC_BASE_URL=
